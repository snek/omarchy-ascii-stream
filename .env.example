# Copy to .env and adjust:
#   cp .env.example .env

# Host port published by Docker. Viewers connect with:
#   ssh -p 2222 -o StrictHostKeyChecking=no <your-vps>
SSH_PUBLIC_PORT=2222

# Path *inside the container*. Put a file at ./clips/video.mp4
# or change this to match whatever you dropped in ./clips.
VIDEO_PATH=/clips/video.mp4

# 0 = use the source frame rate
FPS=0

# Decode width in cells. Higher = sharper, more RAM.
GRID_COLS=160
